# Lastboard configuration — copy to .env and adjust as needed.
# Every value shown is the built-in default; uncomment only what you change.

# Path to the SQLite database file.
# DB_FILE=./lastboard.db

# HTTP port the server listens on.
# PORT=8080

# Drop privileges to this user/group after start (Linux only). 0 = no change.
# PUID=0
# PGID=0

# Trust reverse-proxy headers (X-Forwarded-For / X-Forwarded-Proto). Only enable
# when Lastboard sits behind a proxy you control; otherwise clients could spoof
# their IP and protocol.
# TRUST_PROXY=false

# Sign in through an auth proxy in front (Authelia, Authentik, oauth2-proxy):
# the header with the user name, the proxy's own addresses (both needed), and
# where Logout sends people so the proxy signs them out too. Only accounts that
# already exist can sign in this way.
# AUTH_PROXY_HEADER=Remote-User
# AUTH_PROXY_TRUSTED=172.18.0.5
# AUTH_PROXY_LOGOUT_URL=https://auth.example.com/logout

# Read-only public demo mode (frontend-only, no persistence). Leave false for a
# real install.
# DEMO_ONLY=false

# Maximum number of items (bookmarks/widgets) a single user may create.
# MAX_ITEMS_PER_USER=500

# Log output format: "text" (human-readable) or "json" (structured).
# LOG_FORMAT=text

# Timezone for logs and time widgets (standard tz name, honored by the runtime).
# TZ=UTC
